# Copy to .env and adjust. Every value below has a working default for local
# development, so .env is optional -- except JWT_SECRET, which the app refuses
# to leave at its default once DEBUG=false.

# SQLAlchemy connection URL. "db" is the compose service name.
DATABASE_URL=postgresql://spa_user:spa_password@db/spa_db

# --- Authentication ---------------------------------------------------------

# Signs both access and refresh tokens. Anyone holding this value can mint a
# token for any account, so generate a fresh one per deployment:
#   openssl rand -hex 32
JWT_SECRET=insecure-development-secret-change-me

# Access tokens are replayed on every request and live only in the client's
# memory; refresh tokens live in an httpOnly cookie and rotate on each use.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Accounts are restricted to this mail domain. The client mirrors the value in
# src/utils/constants.ts for form feedback; this one is what is enforced.
UNIVERSITY_EMAIL_DOMAIN=uni-hildesheim.de

# Minimum password length accepted at registration. bcrypt caps the useful
# maximum at 72 bytes, which the API enforces regardless of this setting.
MIN_PASSWORD_LENGTH=10

# bcrypt work factor. Each increment doubles the time to hash and to crack.
BCRYPT_ROUNDS=12

# Refresh-cookie flags. Set COOKIE_SECURE=true wherever the site is served
# over HTTPS. COOKIE_SAMESITE=lax is right when the client and API share a
# registrable domain (including localhost:5173 -> localhost:8000); use "none"
# only if they are genuinely cross-site, which also requires COOKIE_SECURE.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# false turns the development guard rails into startup errors.
DEBUG=true

# Optional first account, created only while the users table is empty. Leave
# blank to have the first user register through the app instead.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# --- CORS -------------------------------------------------------------------

# Comma-separated allow-list of client origins. "*" is not usable here: the
# refresh cookie makes auth requests credentialed, and browsers reject a
# wildcard origin on those. List the client's real origin instead.
# In local development: http://localhost:5173,http://127.0.0.1:5173
# On a deployed server: http://<server-ip-or-domain>:5173 (or https://<server-ip-or-domain>)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Data -------------------------------------------------------------------

# Populate an empty database with demonstration data at startup.
SEED_ON_STARTUP=true

# Credentials for the postgres container in docker-compose.yml.
POSTGRES_USER=spa_user
POSTGRES_PASSWORD=spa_password
POSTGRES_DB=spa_db
