# Copy to .env and adjust. Every value below has a working default, so .env is
# optional for local development.

# SQLAlchemy connection URL. "db" is the compose service name.
DATABASE_URL=postgresql://spa_user:spa_password@db/spa_db

# Bearer token the client must send on mutating endpoints. Change this
# anywhere that is not a local machine -- the client sends the matching value
# from its own VITE_API_TOKEN.
API_TOKEN=sse-staff-token

# Comma-separated CORS allow-list, or * for any origin.
CORS_ORIGINS=*

# Populate an empty database with demonstration data at startup.
SEED_ON_STARTUP=true

# Credentials for the postgres container in docker-compose.yml.
POSTGRES_USER=spa_user
POSTGRES_PASSWORD=spa_password
POSTGRES_DB=spa_db
